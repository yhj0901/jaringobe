# ================= 자린고비 환경변수 템플릿 =================
# 실제 .env 는 커밋 금지 (.gitignore 처리). 이 파일만 커밋.
# 저장소 루트에 .env 하나만 두면 로컬(호스트 실행)·docker compose 양쪽에서 모두 읽는다.

# --- PostgreSQL ---
POSTGRES_USER=jaringobe
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_DB=jaringobe

# --- 호스트 노출 포트 (다른 프로젝트와 충돌 시 변경) ---
# compose 가 사용: db → ${POSTGRES_PORT}:5432 / backend → ${BACKEND_PORT}:8000
POSTGRES_PORT=5432
BACKEND_PORT=8000

# --- 백엔드 DB 연결 ---
# 호스트에서 직접 실행할 때(uv run uvicorn / uv run alembic)의 주소.
# 포트는 위 POSTGRES_PORT 와 반드시 일치시킬 것.
# (docker compose 로 띄우면 compose 가 db:5432 로 덮어쓰므로 이 값은 무시된다)
DATABASE_URL=postgresql+asyncpg://jaringobe:change-me-in-prod@localhost:5432/jaringobe

# --- 테스트 DB (pytest 전용) ---
# 운영 DB 와 반드시 분리. pytest 가 매 테스트마다 스키마를 drop/create 한다.
TEST_DATABASE_URL=postgresql+asyncpg://jaringobe:change-me-in-prod@localhost:5432/jaringobe_test

# --- 인증 (JWT + 소셜 로그인) ---
# JWT_SECRET: 64자 이상 랜덤 문자열 권장 (예: openssl rand -hex 32)
JWT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 애플 로그인(P1) 도입 시 추가: APPLE_CLIENT_ID / APPLE_TEAM_ID / APPLE_KEY_ID / APPLE_PRIVATE_KEY_PATH

# --- 프론트엔드 오리진 (Origin 검증·OAuth 복귀 리다이렉트 베이스) ---
FRONTEND_ORIGIN=http://localhost:3000

# --- 쿠키 보안 (배포 https 환경에서는 반드시 true) ---
COOKIE_SECURE=false

# --- 프론트엔드 rewrites 대상 백엔드 주소 (Next.js) ---
BACKEND_URL=http://localhost:8000

# --- LLM (Claude API) ---
# 비어 있으면 백엔드가 mock 모드로 표시됨. 실제 키는 여기에만 입력.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# --- 마트 연동 (네이버 쇼핑 검색 API) ---
# developers.naver.com 에서 발급. 비어 있으면 store 검색 결과 없음.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- 푸시 알림 (Expo Push Service) ---
# expo.dev 계정의 Access Token. 비어 있으면 무인증 발송 시도 (개발용).
EXPO_ACCESS_TOKEN=

# --- 앱 딥링크 (모바일 웹뷰 앱 로그인 복귀 스킴) ---
APP_SCHEME=jaringobe

# --- 식단 생성/리마인더 운영 파라미터 (기본값 있음 — 필요 시만 변경) ---
# MEALPLAN_GENERATION_TIMEOUT_MINUTES=10   # processing 좀비 수렴 시간
# REMINDER_SCHEDULER_ENABLED=true
# REMINDER_SCHEDULER_INTERVAL_SECONDS=30

# --- 주간 사이클 스케줄러·운영 정책 ---
CYCLE_SCHEDULER_ENABLED=true
CYCLE_SCHEDULER_INTERVAL_SECONDS=60
CYCLE_PROFILE_WEEKLY={"generateLeadDays":5,"draftLeadDays":2,"graceHours":24}
CYCLE_PROFILE_BIWEEKLY={"generateLeadDays":2,"draftLeadDays":1,"graceHours":12}
CYCLE_STAGE_LOCAL_HOUR=9
CYCLE_JITTER_MINUTES=30
CYCLE_ACTIVE_COMPLETION_MIN=1
CYCLE_ACTIVE_SEEN_DAYS=14
CYCLE_DAILY_GENERATION_LIMIT=200
CYCLE_UNMATCHED_THRESHOLD=0.30
CYCLE_DELIVERY_LEAD_DAYS={"kurly":1,"coupang":1,"ssg":1,"naver":2,"walmart":2,"instacart":1}
CYCLE_DELIVERY_LEAD_DAYS_DEFAULT=1
CYCLE_EXPIRING_DAYS={"KR":3,"US":5}
CYCLE_FRIDGE_PROMPT_MAX_EXPIRING_LINES=15
CYCLE_FRIDGE_PROMPT_MAX_LINES=25
CYCLE_DRAFT_RETRY_DELAYS_MINUTES=1,5,15
CYCLE_CANCEL_WINDOW_DAYS=7
CYCLE_DELIVERY_UNKNOWN_ATTEMPTS=3
# ================= 이관/배포 서버 전용 (docker/docker-compose.server.yml) =================
# 로컬 개발에서는 불필요.

# Caddy 가 자동 TLS 를 발급할 도메인. 비워두면 :80 HTTP 로 서비스(IP 접속·내부망 검증용).
API_DOMAIN=

# 컨테이너 기동 시 alembic upgrade head 자동 실행 여부 (수동 운용 시 false)
RUN_MIGRATIONS=true
